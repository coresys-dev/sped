{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speed Editor Control",
  "version": "0.1.0",
  "identifier": "com.coresys.speededitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Speed Editor Control",
        "width": 1280,
        "height": 720,
        "minWidth": 1000,
        "minHeight": 640,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
